<file path="docker-compose.yaml">
services:
  qwen-tts:
    build:
      context: ./runtime

    container_name: qwen3-tts

    ports:
      - "8889:8889"

    volumes:
      - ./cache/huggingface:/models/hf
      - ./data:/data
      - ./outputs:/outputs

    environment:
      HF_HOME: /models/hf
      HF_HUB_CACHE: /models/hf/hub

      MODEL_ID: Qwen/Qwen3-TTS-12Hz-1.7B-Base

      DEVICE: cuda:0
      ATTENTION_IMPL: sdpa

      REFERENCE_AUDIO: /data/references/ref.wav
      REFERENCE_TEXT_FILE: /data/references/ref.txt

    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]

    shm_size: "4gb"

    restart: unless-stopped

    healthcheck:
      test:
        [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8889/health"
        ]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s
</file>

